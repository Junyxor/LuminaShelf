{
  "name": "lumina-shelf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:android": "node scripts/smoke-android.mjs",
    "tauri": "tauri",
    "android:init": "tauri android init && node scripts/patch-android-keyring.mjs",
    "android:prepare": "node scripts/patch-android-keyring.mjs",
    "android:apk:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-windows.ps1",
    "android:apk": "tauri android build --debug --apk --target aarch64"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.1"
  }
}
